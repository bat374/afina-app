{
  "expo": {
    "name": "Афина",
    "slug": "afinaapp",
    "version": "1.3.0",
    "icon": "./assets/icon-v2.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#EDF5F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.afina.finance"
    },
    "android": {
      "package": "app.afina.finance",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-v2.png",
        "backgroundColor": "#263C4A"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешите Афине выбрать скриншот или фото чека для распознавания операций.",
          "cameraPermission": "Разрешите Афине использовать камеру, чтобы сфотографировать чек."
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Разрешите Афине использовать Face ID для входа в приложение."
        }
      ]
    ],
    "runtimeVersion": "1.3.0",
    "updates": {
      "url": "https://u.expo.dev/53ab750b-30b0-4e8f-abf6-75e0b537f801",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "eas": {
        "projectId": "53ab750b-30b0-4e8f-abf6-75e0b537f801"
      }
    }
  }
}
